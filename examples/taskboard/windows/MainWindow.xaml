<Window
    x:Class="RivetHost.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Rivet Taskboard" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="Racket + WinUI 3" VerticalAlignment="Center" Opacity="0.65" />
        </StackPanel>

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="1"
            IsOpen="True"
            IsClosable="False"
            Severity="Informational"
            Message="Starting embedded Racket CS…"
            AutomationProperties.AutomationId="application-status" />

        <Grid Grid.Row="2" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="280" />
                <ColumnDefinition Width="3*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <ListView
                x:Name="TaskList"
                SelectionMode="Single"
                IsEnabled="False"
                SelectionChanged="TaskList_SelectionChanged"
                ContainerContentChanging="TaskList_ContainerContentChanging"
                AutomationProperties.Name="Tasks"
                AutomationProperties.AutomationId="task-list">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding [Title]}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border Grid.Column="1" Padding="28" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="14">
                    <TextBlock
                        x:Name="TaskTitle"
                        Text="Select a task"
                        FontSize="26"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap"
                        AutomationProperties.AutomationId="task-title" />
                    <TextBox
                        x:Name="EditTitleBox"
                        Header="Task title (session-only; resets on restart)"
                        MaxLength="4000"
                        Visibility="Collapsed"
                        KeyDown="EditTitle_KeyDown"
                        AutomationProperties.AutomationId="edit-task-title" />
                    <TextBlock x:Name="TaskStatus" Opacity="0.65" />
                    <TextBlock
                        x:Name="TaskNotes"
                        Text="Task details are provided by the shared Racket backend."
                        TextWrapping="Wrap"
                        AutomationProperties.AutomationId="task-notes" />
                    <!-- Separate action rows prevent the long edit controls from
                         clipping in the minimum-width native detail pane. -->
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button
                                x:Name="EditButton"
                                Content="Edit title"
                                IsEnabled="False"
                                Click="Edit_Click"
                                AutomationProperties.AutomationId="edit-task" />
                            <Button
                                x:Name="AdvanceButton"
                                Content="Start Task"
                                IsEnabled="False"
                                Click="Advance_Click"
                                AutomationProperties.AutomationId="advance-task" />
                            <Button
                                x:Name="DeleteButton"
                                Content="Delete"
                                IsEnabled="False"
                                Click="Delete_Click"
                                AutomationProperties.AutomationId="delete-task" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <Button
                                x:Name="SaveEditButton"
                                Content="Apply for this session"
                                HorizontalAlignment="Left"
                                Visibility="Collapsed"
                                Click="SaveEdit_Click"
                                AutomationProperties.AutomationId="save-task" />
                            <Button
                                x:Name="CancelEditButton"
                                Content="Discard draft"
                                HorizontalAlignment="Left"
                                Visibility="Collapsed"
                                Click="CancelEdit_Click"
                                AutomationProperties.AutomationId="cancel-task-edit" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Spacing="8">
            <ToggleSwitch
                x:Name="StreamToggle"
                Header="Live timing stream (chart data plane)"
                OnContent="Streaming" OffContent="Stopped"
                Toggled="StreamToggle_Toggled"
                AutomationProperties.AutomationId="stream-toggle" />
            <ContentControl x:Name="ChartHost" MinHeight="140" HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="timing-chart" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10">
            <Button x:Name="NewButton" Content="New Task" IsEnabled="False"
                    Click="New_Click" AutomationProperties.AutomationId="new-task" />
            <Button x:Name="SamplesButton" Content="Reload Samples" IsEnabled="False"
                    Click="Samples_Click" AutomationProperties.AutomationId="reload-samples" />
            <Button x:Name="GenerateButton" Content="Generate 1,000" IsEnabled="False"
                    Click="Generate_Click" AutomationProperties.AutomationId="generate-demo" />
            <Button x:Name="CancelButton" Content="Cancel" Visibility="Collapsed"
                    Click="Cancel_Click" AutomationProperties.AutomationId="cancel-generation" />
        </StackPanel>
    </Grid>
</Window>
