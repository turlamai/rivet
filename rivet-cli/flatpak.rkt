#lang racket/base

;; Flatpak bundle packaging for Linux Rivet apps.
;;
;; The manifest is framework-owned dependency-closure knowledge: the release
;; payload links exactly two libraries outside the GNOME Platform runtime —
;; liblz4.so.1 and libtinfo.so.6 — provided by the pinned lz4 and ncurses
;; modules. Products declare only their sandbox surface (`flatpak-finish-args`)
;; and may replace the whole manifest with `flatpak-manifest` for unusual
;; cases. The tar.gz that `create-linux-installer!` already built and verified
;; is the bundle payload, so there is one source of truth per release.
;;
;; Builds run unprivileged with --disable-rofiles-fuse, matching the family CI
;; recipe (hosted runners have no /dev/fuse). Updates are owned by Flatpak's
;; remote machinery, so the bundle is not part of the signed self-update feed.

(require racket/file
         racket/format
         racket/list
         racket/path
         racket/port
         racket/string
         racket/system
         "../rivet/distribution/crypto.rkt"
         "../rivet/distribution/identity.rkt"
         "artifact-file.rkt"
         "linux-native-package.rkt"
         "project.rkt")

(provide flatpak-app-id
         flatpak-architecture
         flatpak-bundle-path
         render-flatpak-manifest
         write-flatpak-desktop-entry!
         create-flatpak-bundle!)

(define flatpak-runtime-version "50")

;; The manifest and build commands quote untrusted-ish project metadata.
;; YAML single-quoted scalars escape a quote by doubling it; shell arguments
;; use the standard '\'' sequence.
(define (yaml-string value)
  (string-append "'" (string-replace value "'" "''") "'"))

(define (shell-quote value)
  (string-append "'" (string-replace value "'" "'\\''") "'"))

(define (flatpak-architecture)
  (case (system-type 'arch)
    [(aarch64 arm64) "aarch64"]
    [else "x86_64"]))

(define (flatpak-app-id project)
  (define identifier (project-identifier project))
  (unless (regexp-match?
           #px"^[A-Za-z][A-Za-z0-9_-]*(?:\\.[A-Za-z][A-Za-z0-9_-]*)+$"
           identifier)
    (raise-arguments-error
     'create-flatpak-bundle!
     "Flatpak requires a reverse-DNS identifier with at least two components"
     "identifier" identifier))
  identifier)

;; Release assets use the family architecture spelling (x64/arm64), matching
;; the tar.gz and portable zip; Flatpak's own spelling (x86_64/aarch64) is
;; only needed when a manifest states an architecture explicitly.
(define (flatpak-bundle-path project)
  (project-path
   project "dist"
   (format "~a-~a-linux-~a.flatpak"
           (project-name project)
           (project-version project)
           (architecture-symbol))))

(define (render-flatpak-manifest project tar-gz
                                 #:finish-args [finish-args #f]
                                 #:icon [icon #f]
                                 #:desktop-name [desktop-name #f])
  (define app-id (flatpak-app-id project))
  (define binary (project-linux-binary-name project))
  (define name (project-name project))
  (define tar-name (path->string (file-name-from-path tar-gz)))
  (define tar-sha (sha256-file/hex tar-gz))
  (unless (and finish-args (list? finish-args))
    (raise-arguments-error
     'create-flatpak-bundle!
     "Flatpak packaging requires `flatpak-finish-args` in rivet.rktd (an explicitly empty list is allowed)"
     "project" name))
  (string-join
   (append
    (list "# Generated by `raco rivet release`; product sandbox decisions belong"
          "# in `flatpak-finish-args`, not in this generated file."
          (format "app-id: ~a" (yaml-string app-id))
          "runtime: org.gnome.Platform"
          (format "runtime-version: ~a" (yaml-string flatpak-runtime-version))
          "sdk: org.gnome.Sdk"
          (format "command: ~a" (yaml-string binary))
          "branch: stable"
          "separate-locales: false"
          "finish-args:")
    (for/list ([argument (in-list finish-args)])
      (format "  - ~a" (yaml-string argument)))
    (list
     "modules:"
     "  - name: lz4"
     "    # Upstream keeps meson under build/, so use the primary Makefile"
     "    # build; only the library is installed."
     "    buildsystem: simple"
     "    build-commands:"
     "      - make lib-release PREFIX=/app"
     "      - make -C lib install PREFIX=/app"
     "    sources:"
     "      - type: git"
     "        url: https://github.com/lz4/lz4.git"
     "        tag: v1.9.4"
     "        commit: 5ff839680134437dbf4678f3d0c7b371d84f4964"
     "  - name: ncurses"
     "    # libtinfo.so.6 only; no programs and no terminfo database. The C++"
     "    # binding does not survive the GNOME 50 SDK's GCC 15 libstdc++."
     "    config-opts:"
     "      - --prefix=/app"
     "      - --with-shared"
     "      - --with-termlib"
     "      - --without-progs"
     "      - --without-tack"
     "      - --without-tests"
     "      - --without-cxx-binding"
     "      - --without-cxx"
     "      - --disable-db-install"
     "    sources:"
     "      - type: archive"
     "        url: https://ftp.gnu.org/pub/gnu/ncurses/ncurses-6.5.tar.gz"
     "        sha256: 136d91bc269a9a5785e5f9e980bc76ab57428f604ce3e5a5a90cebc767971cc6"
     (format "  - name: ~a" (yaml-string name))
     "    buildsystem: simple"
     "    sources:"
     "      - type: archive"
     (format "        path: ~a" (yaml-string tar-name))
     (format "        sha256: ~a" (yaml-string tar-sha)))
    (if icon
        (list "      - type: file"
              (format "        path: ~a"
                      (yaml-string (path->string (file-name-from-path icon)))))
        '())
    (if desktop-name
        (list "      - type: file"
              (format "        path: ~a" (yaml-string desktop-name)))
        '())
    (list
     "    build-commands:"
     (format "      - mkdir -p ~a"
             (shell-quote (string-append "/app/" name)))
     ;; flatpak-builder strips the archive's leading directory, so the build
     ;; directory is the package payload (binary, runtime/, res/, app/).
     (format "      - cp -a . ~a"
             (shell-quote (string-append "/app/" name "/"))))
    (if icon
        (list
         (format "      - install -Dm644 ~a ~a"
                 (shell-quote (path->string (file-name-from-path icon)))
                 (shell-quote
                  (format "/app/share/icons/hicolor/512x512/apps/~a.png"
                          app-id))))
        '())
    (if desktop-name
        (list
         (format "      - install -Dm644 ~a ~a"
                 (shell-quote desktop-name)
                 (shell-quote
                  (format "/app/share/applications/~a" desktop-name))))
        '())
    (list "      - mkdir -p /app/bin"
          (format "      - ln -sf ~a ~a"
                  (shell-quote (format "/app/~a/~a" name binary))
                  (shell-quote (format "/app/bin/~a" binary)))))
   "\n"))

(define (write-flatpak-desktop-entry! project destination)
  (write-desktop-entry!
   project destination
   #:exec (project-linux-binary-name project)
   #:icon-name (and (project-linux-icon project) (flatpak-app-id project))))

(define (run-flatpak-command! who executable . arguments)
  (unless executable
    (raise-arguments-error who "required executable was not found"))
  ;; Stream the builder's own diagnostics to stderr: a truncated capture in
  ;; the exception message hides the failing module, and flatpak-builder's
  ;; progress is useful in CI logs.
  (define status
    (parameterize ([current-output-port (current-error-port)])
      (apply system*/exit-code executable arguments)))
  (unless (zero? status)
    (raise-arguments-error
     who
     "external command failed"
     "executable" executable
     "arguments" arguments
     "exit-code" status)))

(define (quiet-command? executable . arguments)
  (and executable
       (parameterize ([current-output-port (open-output-nowhere)]
                      [current-error-port (open-output-nowhere)])
         (zero? (apply system*/exit-code executable arguments)))))

(define (verify-flatpak-runtime! flatpak)
  (define arch (flatpak-architecture))
  (define runtime
    (format "org.gnome.Platform/~a/~a" arch flatpak-runtime-version))
  (define sdk
    (format "org.gnome.Sdk/~a/~a" arch flatpak-runtime-version))
  (unless (and (quiet-command? flatpak "--user" "info" runtime)
               (quiet-command? flatpak "--user" "info" sdk))
    (raise-arguments-error
     'create-flatpak-bundle!
     "the GNOME runtime or SDK is not installed for the current user"
     "runtime" runtime
     "sdk" sdk
     "remediation"
     (format
      "Run `flatpak --user remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo` then `flatpak --user install flathub ~a ~a`."
      runtime sdk))))

(define (create-flatpak-bundle! project tar-gz)
  ;; Validate the product-owned configuration before probing tools so a
  ;; missing sandbox declaration fails with the remediation that fixes it.
  (define app-id (flatpak-app-id project))
  (define finish-args (project-flatpak-finish-args project))
  (unless (list? finish-args)
    (raise-arguments-error
     'create-flatpak-bundle!
     "Flatpak packaging requires `flatpak-finish-args` in rivet.rktd (an explicitly empty list is allowed)"
     "project" (project-name project)))
  (define override (project-flatpak-manifest project))
  (define flatpak-builder (find-executable-path "flatpak-builder"))
  (unless flatpak-builder
    (error 'create-flatpak-bundle!
           "flatpak-builder was not found; install the flatpak and flatpak-builder packages"))
  (define flatpak (find-executable-path "flatpak"))
  (unless flatpak
    (error 'create-flatpak-bundle!
           "flatpak was not found; install the flatpak package"))
  ;; An override owns its runtime choice; the generated manifest always uses
  ;; the framework pin and is checked here.
  (unless override
    (verify-flatpak-runtime! flatpak))
  (define icon (project-linux-icon project))
  (define output (flatpak-bundle-path project))
  (make-directory* (project-path project "dist"))
  (define stage (make-temporary-file "rivet-flatpak-~a" 'directory))
  (dynamic-wind
   void
   (lambda ()
     (define staged-tar (build-path stage (file-name-from-path tar-gz)))
     (copy-file tar-gz staged-tar #t)
     (define manifest (build-path stage "flatpak-manifest.yml"))
     (define desktop-name (string-append app-id ".desktop"))
     (cond
       [override
        ;; The override is used verbatim; the staging directory contains the
        ;; tar.gz under its release name and the manifest beside it.
        (copy-file (project-path project override) manifest #t)]
       [else
        (when icon
          (copy-file (project-path project icon)
                     (build-path stage (file-name-from-path icon))
                     #t))
        (write-flatpak-desktop-entry! project (build-path stage desktop-name))
        (call-with-output-file manifest
          #:exists 'truncate/replace
          (lambda (out)
            (display (render-flatpak-manifest
                      project staged-tar
                      #:finish-args finish-args
                      #:icon icon
                      #:desktop-name desktop-name)
                     out)))])
     (define repo (build-path stage "flatpak-repo"))
     (define build-dir (build-path stage "flatpak-build"))
     (parameterize ([current-directory stage])
       (run-flatpak-command!
        'create-flatpak-bundle!
        flatpak-builder
        "--user" "--force-clean" "--disable-rofiles-fuse"
        (format "--repo=~a" (path->string repo))
        (path->string build-dir)
        (path->string manifest)))
     (run-flatpak-command!
      'create-flatpak-bundle!
      flatpak "build-bundle"
      (path->string repo)
      (path->string output)
      app-id "stable")
     (write-sha256-sidecar! output)
     output)
   (lambda ()
     (delete-directory/files stage #:must-exist? #f))))
